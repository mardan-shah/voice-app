{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {},
      "tools": ["*"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${COPILOT_MCP_CONTEXT7_API_KEY:-}"
      },
      "tools": ["*"]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${COPILOT_MCP_GITHUB_TOKEN:-}"
      },
      "tools": ["*"]
    },
    "nextjs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "env": {},
      "tools": ["*"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {},
      "tools": ["*"]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=fnkpgiikjitchdlikigr&read_only=true&features=docs%2Cdatabase%2Cdebugging%2Cdevelopment",
      "tools": [
        "*"]
    },
    "nextjs-docs-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@taiyokimura/nextjs-docs-mcp@latest"],
      "env": {},
      "tools": ["*"]
    }
  }
}
