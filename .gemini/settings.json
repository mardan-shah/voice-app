{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "nextjs": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=fnkpgiikjitchdlikigr&read_only=true&features=docs%2Cdatabase%2Cdebugging%2Cdevelopment",
      "type": "http"
    },
    "nextjs-docs-mcp": {
      "command": "npx",
      "args": [
        "@taiyokimura/nextjs-docs-mcp@latest"
      ]
    }
  }
}
